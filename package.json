{
  "name": "zudo-design-token-panel-example-vite-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vite + React example app demonstrating @takazudo/zdtp — host-config-driven panel mounted as a Preact island from a useEffect, plus apply-pipeline round-trip via the bin sidecar.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "lsof -ti:44325 | xargs kill 2>/dev/null; lsof -ti:24683 | xargs kill 2>/dev/null; true",
    "dev": "concurrently -k -n vite,tokens-bin -c blue,green \"pnpm run _dev:vite\" \"pnpm run _dev:tokens-bin\"",
    "_dev:vite": "vite --port 44325",
    "_dev:tokens-bin": "zdtp-server --write-root . --routing scaffold.routing.json --port 24683 --allow-origin http://localhost:44325",
    "build": "vite build",
    "preview": "vite preview --port 44325",
    "typecheck": "tsc --noEmit",
    "test:apply-smoke": "node scripts/smoke-apply.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@takazudo/zdtp": "0.5.1",
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "wrangler": "4.85.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "miniflare>ws": "8.21.3",
      "miniflare>undici": "7.29.1"
    }
  }
}
